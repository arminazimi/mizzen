{
  "name": "@velella/mizzen",
  "version": "0.1.0",
  "description": "A deterministic docs engine with exact source positions.",
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "static-site",
    "agents",
    "velella",
    "engine",
    "deterministic",
    "source-map"
  ],
  "homepage": "https://velella.sh/mizzen/",
  "bugs": {
    "url": "https://github.com/velella-sh/mizzen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/mizzen.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mizzen": "bin/mizzen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "coverage:badge": "node scripts/coverage-badge.ts coverage/lcov.info coverage/coverage.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.6.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "preact": "^11.2.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "bin/mizzen.js",
    "dist",
    "schema",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
